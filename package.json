{
  "name": "@sales-next/knowledge-base",
  "version": "0.1.0",
  "description": "獨立的企業知識庫模組：資料夾與標籤兩套獨立分類、AI 自動分類、附出處的問答檢索。可獨立使用，也可 import 進 Sales Next。",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./providers/bedrock": "./src/providers/bedrock.ts",
    "./styles.css": "./src/react/styles.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/smoke.ts",
    "test:aws": "tsx scripts/aws-integration.ts"
  },
  "peerDependencies": {
    "@anthropic-ai/bedrock-sdk": ">=0.10",
    "@aws-sdk/client-bedrock-runtime": ">=3",
    "@aws-sdk/client-s3": ">=3",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/bedrock-sdk": {
      "optional": true
    },
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.32.4",
    "@aws-sdk/client-bedrock-runtime": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "knowledge-base",
    "rag",
    "crm",
    "bedrock",
    "s3"
  ]
}
