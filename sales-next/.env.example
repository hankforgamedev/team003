# Copy this file to .env.local and fill in your real keys.
# .env.local is ignored by git.

# Default text AI provider is AWS Bedrock.
# Settings page can switch the browser workspace between Bedrock and OpenAI GPT.

# AWS Bedrock: CRM extraction, NBA, knowledge-base answers when provider = bedrock.
BEDROCK_AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
BEDROCK_MODEL=anthropic.claude-opus-5

# OpenAI: GPT fallback/provider and Whisper transcription.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
